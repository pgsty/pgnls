#: check.c:75
#, c-format
msgid ""
"Performing Consistency Checks on Old Live Server\n"
"------------------------------------------------\n"
msgstr "正在對執行中的舊伺服器執行一致性檢查\n------------------------------------------------\n"

#: check.c:81
#, c-format
msgid ""
"Performing Consistency Checks\n"
"-----------------------------\n"
msgstr "正在執行一致性檢查\n-----------------------------\n"

#: check.c:242
#, c-format
msgid ""
"\n"
"*Clusters are compatible*\n"
msgstr "\n*叢集相容*\n"

#: check.c:248
#, c-format
msgid ""
"\n"
"If pg_upgrade fails after this point, you must re-initdb the\n"
"new cluster before continuing.\n"
msgstr "\n如果 pg_upgrade 在此之後失敗，必須重新對新叢集執行 initdb，\n然後才能繼續。\n"

#: check.c:293
#, c-format
msgid ""
"Optimizer statistics are not transferred by pg_upgrade.\n"
"Once you start the new server, consider running:\n"
"    %s/vacuumdb %s--all --analyze-in-stages\n"
"\n"
msgstr "pg_upgrade 不會傳輸最佳化工具統計資訊。\n啟動新伺服器後，考慮執行:\n    %s/vacuumdb %s--all --analyze-in-stages\n\n"

#: check.c:299
#, c-format
msgid ""
"Running this script will delete the old cluster's data files:\n"
"    %s\n"
msgstr "執行此指令碼將刪除舊叢集的資料檔案:\n    %s\n"

#: check.c:304
#, c-format
msgid ""
"Could not create a script to delete the old cluster's data files\n"
"because user-defined tablespaces or the new cluster's data directory\n"
"exist in the old cluster directory.  The old cluster's contents must\n"
"be deleted manually.\n"
msgstr "無法建立刪除舊叢集資料檔案的指令碼，\n因為使用者定義的表空間或新叢集的資料目錄\n位於舊叢集目錄內。必須手動刪除\n舊叢集的內容。\n"

#: check.c:316
#, c-format
msgid "Checking cluster versions"
msgstr "檢查叢集版本"

#: check.c:333
#, c-format
msgid "This utility can only upgrade from PostgreSQL version 9.0 and later.\n"
msgstr "此工具只能從 PostgreSQL 9.0 及更高版本升級。\n"

#: check.c:337
#, c-format
msgid "This utility can only upgrade to PostgreSQL version %s.\n"
msgstr "此工具只能升級到 PostgreSQL %s。\n"

#: check.c:346
#, c-format
msgid "This utility cannot be used to downgrade to older major PostgreSQL versions.\n"
msgstr "此工具不能用於降級到較舊的 PostgreSQL 主版本。\n"

#: check.c:351
#, c-format
msgid "Old cluster data and binary directories are from different major versions.\n"
msgstr "舊叢集的資料目錄與可執行檔案目錄來自不同的主版本。\n"

#: check.c:354
#, c-format
msgid "New cluster data and binary directories are from different major versions.\n"
msgstr "新叢集的資料目錄與可執行檔案目錄來自不同的主版本。\n"

#: check.c:371
#, c-format
msgid "When checking a pre-PG 9.1 live old server, you must specify the old server's port number.\n"
msgstr "檢查執行中的 PG 9.1 之前版本的舊伺服器時，必須指定舊伺服器的連接埠號。\n"

#: check.c:375
#, c-format
msgid "When checking a live server, the old and new port numbers must be different.\n"
msgstr "檢查執行中的伺服器時，新舊連接埠號必須不同。\n"

#: check.c:390
#, c-format
msgid "encodings for database \"%s\" do not match:  old \"%s\", new \"%s\"\n"
msgstr "資料庫 \"%s\" 的編碼不匹配: 舊值 \"%s\", 新值 \"%s\"\n"

#: check.c:395
#, c-format
msgid "lc_collate values for database \"%s\" do not match:  old \"%s\", new \"%s\"\n"
msgstr "資料庫 \"%s\" 的 lc_collate 值不匹配: 舊值 \"%s\", 新值 \"%s\"\n"

#: check.c:398
#, c-format
msgid "lc_ctype values for database \"%s\" do not match:  old \"%s\", new \"%s\"\n"
msgstr "資料庫 \"%s\" 的 lc_ctype 值不匹配: 舊值 \"%s\", 新值 \"%s\"\n"

#: check.c:471
#, c-format
msgid "New cluster database \"%s\" is not empty: found relation \"%s.%s\"\n"
msgstr "新叢集資料庫 \"%s\" 不為空: 發現關聯 \"%s.%s\"\n"

#: check.c:528
#, c-format
msgid "Checking for new cluster tablespace directories"
msgstr "檢查新叢集的表空間目錄"

#: check.c:539
#, c-format
msgid "new cluster tablespace directory already exists: \"%s\"\n"
msgstr "新叢集的表空間目錄已存在: \"%s\"\n"

#: check.c:572
#, c-format
msgid ""
"\n"
"WARNING:  new data directory should not be inside the old data directory, e.g. %s\n"
msgstr "\n警告:  新資料目錄不宜位於舊資料目錄內，例如 %s\n"

#: check.c:596
#, c-format
msgid ""
"\n"
"WARNING:  user-defined tablespace locations should not be inside the data directory, e.g. %s\n"
msgstr "\n警告:  使用者定義的表空間位置不宜位於資料目錄內，例如 %s\n"

#: check.c:606
#, c-format
msgid "Creating script to delete old cluster"
msgstr "建立刪除舊叢集的腳本"

# fe-lobj.c:410
# fe-lobj.c:495
#: check.c:609 check.c:873 check.c:971 check.c:1101 check.c:1179 check.c:1258
#: check.c:1553 file.c:338 function.c:240 option.c:497 version.c:54
#: version.c:204 version.c:407 version.c:542
#, c-format
msgid "could not open file \"%s\": %s\n"
msgstr "無法開啟檔案 \"%s\": %s\n"

#: check.c:665
#, c-format
msgid "could not add execute permission to file \"%s\": %s\n"
msgstr "無法為檔案 \"%s\" 新增執行權限: %s\n"

#: check.c:685
#, c-format
msgid "Checking database user is the install user"
msgstr "檢查資料庫使用者是否為安裝使用者"

#: check.c:701
#, c-format
msgid "database user \"%s\" is not the install user\n"
msgstr "資料庫使用者 \"%s\" 不是安裝使用者\n"

#: check.c:712
#, c-format
msgid "could not determine the number of users\n"
msgstr "無法確定使用者數量\n"

#: check.c:720
#, c-format
msgid "Only the install user can be defined in the new cluster.\n"
msgstr "新叢集中只能定義安裝使用者。\n"

#: check.c:740
#, c-format
msgid "Checking database connection settings"
msgstr "檢查資料庫連線設定"

#: check.c:762
#, c-format
msgid "template0 must not allow connections, i.e. its pg_database.datallowconn must be false\n"
msgstr "template0 不得允許連線，即其 pg_database.datallowconn 必須為 false\n"

#: check.c:772
#, c-format
msgid "All non-template0 databases must allow connections, i.e. their pg_database.datallowconn must be true\n"
msgstr "除 template0 外的所有資料庫都必須允許連線，即它們的 pg_database.datallowconn 必須為 true\n"

#: check.c:797
#, c-format
msgid "Checking for prepared transactions"
msgstr "檢查已預備的交易"

#: check.c:806
#, c-format
msgid "The source cluster contains prepared transactions\n"
msgstr "來源叢集包含預備交易\n"

#: check.c:808
#, c-format
msgid "The target cluster contains prepared transactions\n"
msgstr "目標叢集包含預備交易\n"

#: check.c:834
#, c-format
msgid "Checking for contrib/isn with bigint-passing mismatch"
msgstr "檢查 contrib/isn 傳遞 bigint 方式不一致"

#: check.c:895 check.c:996 check.c:1121 check.c:1201 check.c:1278 check.c:1336
#: check.c:1395 check.c:1429 check.c:1458 check.c:1576 function.c:262
#: version.c:278 version.c:316 version.c:491
#, c-format
msgid "fatal\n"
msgstr "致命錯誤\n"

#: check.c:896
#, c-format
msgid ""
"Your installation contains \"contrib/isn\" functions which rely on the\n"
"bigint data type.  Your old and new clusters pass bigint values\n"
"differently so this cluster cannot currently be upgraded.  You can\n"
"manually dump databases in the old cluster that use \"contrib/isn\"\n"
"facilities, drop them, perform the upgrade, and then restore them.  A\n"
"list of the problem functions is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝有依賴 bigint 資料型別的 \"contrib/isn\" 函式。\n新舊叢集傳遞 bigint 值的方式不同，因此目前不能升級此叢集。\n可以手動備份舊叢集中使用 \"contrib/isn\" 功能的資料庫，\n刪除這些資料庫，執行升級，然後將其復原。\n有問題的函式列在以下檔案中:\n    %s\n\n"

#: check.c:919
#, c-format
msgid "Checking for user-defined postfix operators"
msgstr "檢查使用者定義的後綴運算子"

#: check.c:997
#, c-format
msgid ""
"Your installation contains user-defined postfix operators, which are not\n"
"supported anymore.  Consider dropping the postfix operators and replacing\n"
"them with prefix operators or function calls.\n"
"A list of user-defined postfix operators is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝包含已不再受支援的\n使用者定義字尾運算子。考慮刪除這些字尾運算子，並用\n字首運算子或函式呼叫替代。\n使用者定義的字尾運算子列在以下檔案中:\n    %s\n\n"

#: check.c:1021
#, c-format
msgid "Checking for incompatible polymorphic functions"
msgstr "檢查不相容的多型函數"

#: check.c:1122
#, c-format
msgid ""
"Your installation contains user-defined objects that refer to internal\n"
"polymorphic functions with arguments of type \"anyarray\" or \"anyelement\".\n"
"These user-defined objects must be dropped before upgrading and restored\n"
"afterwards, changing them to refer to the new corresponding functions with\n"
"arguments of type \"anycompatiblearray\" and \"anycompatible\".\n"
"A list of the problematic objects is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝包含引用內部多型函式的使用者定義物件，\n這些函式的參數型別為 \"anyarray\" 或 \"anyelement\"。\n必須在升級前刪除這些使用者定義物件，並在升級後復原，\n同時將其改為引用相應的新函式，\n新函式的參數型別為 \"anycompatiblearray\" 和 \"anycompatible\"。\n有問題的物件列在以下檔案中:\n    %s\n\n"

#: check.c:1147
#, c-format
msgid "Checking for tables WITH OIDS"
msgstr "檢查資料表 WITH OIDS"

#: check.c:1202
#, c-format
msgid ""
"Your installation contains tables declared WITH OIDS, which is not\n"
"supported anymore.  Consider removing the oid column using\n"
"    ALTER TABLE ... SET WITHOUT OIDS;\n"
"A list of tables with the problem is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝包含以 WITH OIDS 宣告的表，此方式已\n不再受支援。考慮使用以下命令刪除 oid 列:\n    ALTER TABLE ... SET WITHOUT OIDS;\n有問題的表列在以下檔案中:\n    %s\n\n"

#: check.c:1227
#, c-format
msgid "Checking for not-null constraint inconsistencies"
msgstr "正在檢查非空條件約束的不一致"

#: check.c:1279
#, c-format
msgid ""
"Your installation contains inconsistent NOT NULL constraints.\n"
"If the parent column(s) are NOT NULL, then the child column must\n"
"also be marked NOT NULL, or the upgrade will fail.\n"
"You can fix this by running\n"
"    ALTER TABLE tablename ALTER column SET NOT NULL;\n"
"on each column listed in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝中存在不一致的 NOT NULL 條件約束。\n如果父表的列為 NOT NULL，子表的對應列也必須標記為 NOT NULL，\n否則升級將失敗。可以執行以下命令來修復:\n    ALTER TABLE tablename ALTER column SET NOT NULL;\n對以下檔案中列出的每一列都執行此操作:\n    %s\n\n"

#: check.c:1308
#, c-format
msgid "Checking for system-defined composite types in user tables"
msgstr "檢查使用者資料表中的系統定義複合型別"

#: check.c:1337
#, c-format
msgid ""
"Your installation contains system-defined composite type(s) in user tables.\n"
"These type OIDs are not stable across PostgreSQL versions,\n"
"so this cluster cannot currently be upgraded.  You can\n"
"drop the problem columns and restart the upgrade.\n"
"A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝在使用者表中包含系統定義的複合型別。\n這些型別的 OID 在不同 PostgreSQL 版本間並不穩定，\n因此目前不能升級此叢集。可以刪除有問題的列，然後重新開始升級。\n有問題的列的清單位於檔案:\n    %s\n\n"

#: check.c:1365
#, c-format
msgid "Checking for reg* data types in user tables"
msgstr "檢查使用者資料表中有無 reg* 資料型別"

#: check.c:1396
#, c-format
msgid ""
"Your installation contains one of the reg* data types in user tables.\n"
"These data types reference system OIDs that are not preserved by\n"
"pg_upgrade, so this cluster cannot currently be upgraded.  You can\n"
"drop the problem columns and restart the upgrade.\n"
"A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝在使用者表中包含某種 reg* 資料型別。\n這些資料型別引用 pg_upgrade 不會保留的系統 OID，\n因此目前不能升級此叢集。可以刪除有問題的列，然後重新開始升級。\n有問題的列的清單位於檔案:\n    %s\n\n"

#: check.c:1420
#, c-format
msgid "Checking for removed \"%s\" data type in user tables"
msgstr "正在檢查使用者表中已移除的 \"%s\" 資料型別"

#: check.c:1430
#, c-format
msgid ""
"Your installation contains the \"%s\" data type in user tables.\n"
"The \"%s\" type has been removed in PostgreSQL version %s,\n"
"so this cluster cannot currently be upgraded.  You can drop the\n"
"problem columns, or change them to another data type, and restart\n"
"the upgrade.  A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝在使用者表中包含 \"%1$s\" 資料型別。\nPostgreSQL %3$s 已移除 \"%2$s\" 型別，因此目前不能升級此叢集。\n可以刪除有問題的列，或將其改為其他資料型別，然後重新開始升級。\n有問題的列的清單位於檔案:\n    %4$s\n\n"

#: check.c:1452
#, c-format
msgid "Checking for incompatible \"jsonb\" data type"
msgstr "正在檢查不相容的 \"jsonb\" 資料型別"

#: check.c:1459
#, c-format
msgid ""
"Your installation contains the \"jsonb\" data type in user tables.\n"
"The internal format of \"jsonb\" changed during 9.4 beta so this\n"
"cluster cannot currently be upgraded.  You can\n"
"drop the problem columns and restart the upgrade.\n"
"A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝在使用者表中包含 \"jsonb\" 資料型別。\n\"jsonb\" 的內部格式在 9.4 beta 期間已發生變化，\n因此目前不能升級此叢集。可以刪除有問題的列，然後重新開始升級。\n有問題的列的清單位於檔案:\n    %s\n\n"

#: check.c:1481
#, c-format
msgid "Checking for roles starting with \"pg_\""
msgstr "檢查以 \"pg_\" 開頭的角色"

#: check.c:1491
#, c-format
msgid "The source cluster contains roles starting with \"pg_\"\n"
msgstr "來源叢集包含以 \"pg_\" 開頭的角色\n"

#: check.c:1493
#, c-format
msgid "The target cluster contains roles starting with \"pg_\"\n"
msgstr "目標叢集包含以 \"pg_\" 開頭的角色\n"

#: check.c:1514
#, c-format
msgid "Checking for user-defined encoding conversions"
msgstr "檢查使用者自訂的編碼轉換"

#: check.c:1577
#, c-format
msgid ""
"Your installation contains user-defined encoding conversions.\n"
"The conversion function parameters changed in PostgreSQL version 14\n"
"so this cluster cannot currently be upgraded.  You can remove the\n"
"encoding conversions in the old cluster and restart the upgrade.\n"
"A list of user-defined encoding conversions is in the file:\n"
"    %s\n"
"\n"
msgstr "您的安裝包含使用者定義的編碼轉換。\n轉換函式參數在 PostgreSQL 14 中已發生變化，\n因此目前不能升級此叢集。可以刪除\n舊叢集中的編碼轉換，然後重新開始升級。\n使用者定義的編碼轉換列在以下檔案中:\n    %s\n\n"

#: check.c:1604
#, c-format
msgid "failed to get the current locale\n"
msgstr "無法取得目前區域\n"

#: check.c:1613
#, c-format
msgid "failed to get system locale name for \"%s\"\n"
msgstr "無法取得 \"%s\" 的系統區域名稱\n"

#: check.c:1619
#, c-format
msgid "failed to restore old locale \"%s\"\n"
msgstr "復原原有區域 \"%s\" 失敗\n"

#: controldata.c:128 controldata.c:196
#, c-format
msgid "could not get control data using %s: %s\n"
msgstr "無法使用 %s 取得控制資料: %s\n"

#: controldata.c:139
#, c-format
msgid "%d: database cluster state problem\n"
msgstr "%d: 資料庫叢集狀態存在問題\n"

#: controldata.c:157
#, c-format
msgid "The source cluster was shut down while in recovery mode.  To upgrade, use \"rsync\" as documented or shut it down as a primary.\n"
msgstr "來源叢集在復原模式下停止。若要升級，按文件說明使用 \"rsync\"，或使其作為主伺服器停止。\n"

#: controldata.c:159
#, c-format
msgid "The target cluster was shut down while in recovery mode.  To upgrade, use \"rsync\" as documented or shut it down as a primary.\n"
msgstr "目標叢集在復原模式下停止。若要升級，按文件說明使用 \"rsync\"，或使其作為主伺服器停止。\n"

#: controldata.c:164
#, c-format
msgid "The source cluster was not shut down cleanly.\n"
msgstr "來源叢集未正常停止。\n"

#: controldata.c:166
#, c-format
msgid "The target cluster was not shut down cleanly.\n"
msgstr "目標叢集未正常停止。\n"

#: controldata.c:177
#, c-format
msgid "The source cluster lacks cluster state information:\n"
msgstr "來源叢集缺少叢集狀態資訊:\n"

#: controldata.c:179
#, c-format
msgid "The target cluster lacks cluster state information:\n"
msgstr "目標叢集缺少叢集狀態資訊:\n"

