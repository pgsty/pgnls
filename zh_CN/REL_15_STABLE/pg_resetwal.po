#: pg_resetwal.c:1144
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]... DATADIR\n"
"\n"
msgstr ""
"用法:\n"
"  %s [选项]... 数据目录\n"

#: pg_resetwal.c:1145
#, c-format
msgid "Options:\n"
msgstr "选项:\n"

#: pg_resetwal.c:1146
#, c-format
msgid ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   set oldest and newest transactions "
"bearing\n"
"                                   commit timestamp (zero means no change)\n"
msgstr ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                 设置提交时间可以检索到的最老的和最新的事务"
"ID\n"
"                                 (0意味着没有变化)\n"

#: pg_resetwal.c:1149
#, c-format
msgid " [-D, --pgdata=]DATADIR            data directory\n"
msgstr " [-D, --pgdata=]DATADIR            数据目录\n"

#: pg_resetwal.c:1150
#, c-format
msgid "  -e, --epoch=XIDEPOCH             set next transaction ID epoch\n"
msgstr "  -e, --epoch=XIDEPOCH             设置下一个事务ID的epoch\n"

#: pg_resetwal.c:1151
#, c-format
msgid "  -f, --force                      force update to be done\n"
msgstr "  -f, --force                      强制更新完成\n"

#: pg_resetwal.c:1152
#, c-format
msgid ""
"  -l, --next-wal-file=WALFILE      set minimum starting location for new "
"WAL\n"
msgstr "  -l, --next-wal-file=WALFILE      设置新的WAL最小起始位置\n"

#: pg_resetwal.c:1153
#, c-format
msgid ""
"  -m, --multixact-ids=MXID,MXID    set next and oldest multitransaction ID\n"
msgstr "  -m, --multixact-ids=MXID,MXID    设置下一个和最旧的多事务ID\n"

#: pg_resetwal.c:1154
#, c-format
msgid ""
"  -n, --dry-run                    no update, just show what would be done\n"
msgstr "  -n, --dry-run                    不更新，只显示将要执行的操作\n"

#: pg_resetwal.c:1155
#, c-format
msgid "  -o, --next-oid=OID               set next OID\n"
msgstr "  -o, --next-oid=OID               设置下一个OID\n"

#: pg_resetwal.c:1156
#, c-format
msgid "  -O, --multixact-offset=OFFSET    set next multitransaction offset\n"
msgstr "  -O, --multixact-offset=OFFSET    设置下一个多事务偏移量\n"

#: pg_resetwal.c:1157
#, c-format
msgid "  -u, --oldest-transaction-id=XID  set oldest transaction ID\n"
msgstr "  -u, --oldest-transaction-id=XID  设置最旧的事务ID\n"

#: pg_resetwal.c:1158
#, c-format
msgid ""
"  -V, --version                    output version information, then exit\n"
msgstr "  -V, --version                    输出版本信息, 然后退出\n"

#: pg_resetwal.c:1159
#, c-format
msgid "  -x, --next-transaction-id=XID    set next transaction ID\n"
msgstr "  -x, --next-transaction-id=XID    设置下一个事务ID\n"

#: pg_resetwal.c:1160
#, c-format
msgid "      --wal-segsize=SIZE           size of WAL segments, in megabytes\n"
msgstr "      --wal-segsize=SIZE           WAL段的大小（兆字节）\n"

#: pg_resetwal.c:1161
#, c-format
msgid "  -?, --help                       show this help, then exit\n"
msgstr "  -?, --help                       显示此帮助信息, 然后退出\n"

