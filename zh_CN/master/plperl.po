#: plperl.c:411
msgid "If true, trusted and untrusted Perl code will be compiled in strict mode."
msgstr "如果为真，则受信任和不受信任的 Perl 代码都将以严格模式编译。"

#: plperl.c:425
msgid "Perl initialization code to execute when a Perl interpreter is initialized."
msgstr "初始化 Perl 解释器时执行的 Perl 初始化代码。"

#: plperl.c:447
msgid "Perl initialization code to execute once when plperl is first used."
msgstr "首次使用 plperl 时执行一次的 Perl 初始化代码。"

#: plperl.c:455
msgid "Perl initialization code to execute once when plperlu is first used."
msgstr "首次使用 plperlu 时执行一次的 Perl 初始化代码。"

#: plperl.c:640
#, c-format
msgid "cannot allocate multiple Perl interpreters on this platform"
msgstr "在这个平台上不能分配多个 Perl 解释器"

#: plperl.c:683
#, c-format
msgid "while executing PostgreSQL::InServer::SPI::bootstrap"
msgstr "执行 PostgreSQL::InServer::SPI::bootstrap 时"

#: plperl.c:892
#, c-format
msgid "while parsing Perl initialization"
msgstr "解析 Perl 初始化代码时"

#: plperl.c:902
#, c-format
msgid "while running Perl initialization"
msgstr "运行 Perl 初始化代码时"

#: plperl.c:1036
#, c-format
msgid "while executing PLC_TRUSTED"
msgstr "执行 PLC_TRUSTED 时"

#: plperl.c:1052
#, c-format
msgid "while executing utf8fix"
msgstr "执行 utf8fix 时"

#: plperl.c:1099
#, c-format
msgid "while executing plperl.on_plperl_init"
msgstr "执行 plperl.on_plperl_init 时"

#: plperl.c:1126
#, c-format
msgid "while executing plperl.on_plperlu_init"
msgstr "执行 plperl.on_plperlu_init 时"

#: plperl.c:1183 plperl.c:1978
#, c-format
msgid "Perl hash contains nonexistent column \"%s\""
msgstr "Perl 哈希包含不存在的列 \"%s\""

#: plperl.c:1188 plperl.c:1983
#, c-format
msgid "cannot set system attribute \"%s\""
msgstr "不能设置系统属性 \"%s\""

#: plperl.c:1329 plperl.c:1344 plperl.c:1365
#, c-format
msgid "multidimensional arrays must have array expressions with matching dimensions"
msgstr "多维数组中各数组表达式的维度必须匹配"

#: plperl.c:1334
#, c-format
msgid "number of array dimensions exceeds the maximum allowed (%d)"
msgstr "数组维数超过允许的最大值（%d）"

#: plperl.c:1401
#, c-format
msgid "array size exceeds the maximum allowed (%zu)"
msgstr "数组大小超过允许的最大值（%zu）"

#: plperl.c:1427
#, c-format
msgid "cannot convert Perl array to non-array type %s"
msgstr "不能将 Perl 数组转换为非数组类型 %s"

#: plperl.c:1540
#, c-format
msgid "cannot convert Perl hash to non-composite type %s"
msgstr "不能将 Perl 哈希转换为非复合类型 %s"

#: plperl.c:1562 plperl.c:3541
#, c-format
msgid "function returning record called in context that cannot accept type record"
msgstr "在不能接受 record 类型的上下文中调用返回 record 类型的函数"

#: plperl.c:1623
#, c-format
msgid "lookup failed for type %s"
msgstr "类型 %s 查找失败"

#: plperl.c:1945
#, c-format
msgid "$_TD->{new} does not exist"
msgstr "$_TD->{new} 不存在"

#: plperl.c:1952
#, c-format
msgid "$_TD->{new} is not a hash reference"
msgstr "$_TD->{new} 不是哈希引用"

#: plperl.c:1990
#, c-format
msgid "cannot set generated column \"%s\""
msgstr "不能设置生成列 \"%s\""

#: plperl.c:2256 plperl.c:3075
#, c-format
msgid "PL/Perl functions cannot return type %s"
msgstr "PL/Perl 函数不能返回类型 %s"

#: plperl.c:2269 plperl.c:3114
#, c-format
msgid "PL/Perl functions cannot accept type %s"
msgstr "PL/Perl 函数不能接受类型为 %s 的参数"

#: plperl.c:2390
#, c-format
msgid "didn't get a CODE reference from compiling function \"%s\""
msgstr "编译函数 \"%s\" 后未得到 CODE 引用"

#: plperl.c:2481
#, c-format
msgid "didn't get a return item from function"
msgstr "未从函数得到一个返回项"

#: plperl.c:2528 plperl.c:2598
#, c-format
msgid "couldn't fetch $_TD"
msgstr "无法获取 $_TD"

#: plperl.c:2552 plperl.c:2618
#, c-format
msgid "didn't get a return item from trigger function"
msgstr "未从触发器函数得到一个返回项"

#: plperl.c:2666
#, c-format
msgid "set-valued function called in context that cannot accept a set"
msgstr "在不能接受集合的上下文中调用返回集合的函数"

#: plperl.c:2671
#, c-format
msgid "materialize mode required, but it is not allowed in this context"
msgstr "需要物化模式，但此上下文不允许使用该模式"

#: plperl.c:2726
#, c-format
msgid "set-returning PL/Perl function must return reference to array or use return_next"
msgstr "返回集合的 PL/Perl 函数必须返回对数组的引用或者使用 return_next"

#: plperl.c:2831
#, c-format
msgid "ignoring modified row in DELETE trigger"
msgstr "正在忽略 DELETE 触发器中已修改的行"

#: plperl.c:2839
#, c-format
msgid "result of PL/Perl trigger function must be undef, \"SKIP\", or \"MODIFY\""
msgstr "PL/Perl 触发器函数的结果必须为 undef, \"SKIP\" 或 \"MODIFY\""

#: plperl.c:3070
#, c-format
msgid "trigger functions can only be called as triggers"
msgstr "触发器函数只能以触发器的形式调用"

#: plperl.c:3444
#, c-format
msgid "query result has too many rows to fit in a Perl array"
msgstr "查询结果中的行数过多，无法放在 Perl 数组中"

#: plperl.c:3518
#, c-format
msgid "cannot use return_next in a non-SETOF function"
msgstr "不能在非 SETOF 函数中使用 return_next"

#: plperl.c:3596
#, c-format
msgid "SETOF-composite-returning PL/Perl function must call return_next with reference to hash"
msgstr "返回 SETOF 复合类型的 PL/Perl 函数必须以哈希引用为参数调用 return_next"

#: plperl.c:4427
#, c-format
msgid "PL/Perl function \"%s\""
msgstr "PL/Perl 函数 \"%s\""

#: plperl.c:4439
#, c-format
msgid "compilation of PL/Perl function \"%s\""
msgstr "编译 PL/Perl 函数 \"%s\""

#: plperl.c:4448
#, c-format
msgid "PL/Perl anonymous code block"
msgstr "PL/Perl 匿名代码块"

#, c-format
#~ msgid "%s"
#~ msgstr "%s"

#, c-format
#~ msgid "number of array dimensions (%d) exceeds the maximum allowed (%d)"
#~ msgstr "数组的维数(%d)超过最大允许值(%d)"
