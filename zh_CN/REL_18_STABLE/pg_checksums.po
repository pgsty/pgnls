msgstr "      --sync-method=METHOD  设置同步文件到磁盘的方法\n"

#: pg_checksums.c:81
#, c-format
msgid "  -v, --verbose            output verbose messages\n"
msgstr "  -v, --verbose            输出详细的消息\n"

#: pg_checksums.c:82
#, c-format
