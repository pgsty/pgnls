#: pg_test_fsync.c:220
#, c-format
msgid "O_DIRECT supported on this platform for open_datasync and open_sync.\n"
msgstr "此平台支持为 open_datasync 和 open_sync 使用 O_DIRECT。\n"

#: pg_test_fsync.c:222
#, c-format
msgid "Direct I/O is not supported on this platform.\n"
msgstr "此平台不支持直接 I/O。\n"

