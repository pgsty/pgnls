#: pg_test_fsync.c:269
#, c-format
msgid ""
"\n"
"Compare file sync methods using one %dkB write:\n"
msgstr ""
"\n"
"通过一次 %d kB 的写入比较文件同步方法:\n"

#: pg_test_fsync.c:271
#, c-format
msgid ""
"\n"
"Compare file sync methods using two %dkB writes:\n"
msgstr ""
"\n"
"通过两次 %d kB 的写入比较文件同步方法:\n"

#: pg_test_fsync.c:272
#, c-format
msgid ""
"(in wal_sync_method preference order, except fdatasync is Linux's default)\n"
msgstr "（按 wal_sync_method 的优先顺序排列，但 Linux 默认使用 fdatasync）\n"

#: pg_test_fsync.c:283 pg_test_fsync.c:390 pg_test_fsync.c:457
msgid "n/a*"
msgstr "n/a*"

#: pg_test_fsync.c:302 pg_test_fsync.c:328 pg_test_fsync.c:378
#: pg_test_fsync.c:416 pg_test_fsync.c:475
